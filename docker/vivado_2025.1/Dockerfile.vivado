# Dockerfile
FROM ubuntu:24.04 AS builder

# Minimal dependencies for Vivado headless installation
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    # Compatibility libraries
    libncurses6 \
    libncursesw6 \
    libtinfo6 \
    # Core system libraries
    libstdc++6 \
    libc6-i386 \
    # Installer utilities
    python3 \
    python3-pip \
    net-tools \
    # Locale support
    locales \
    # Symlinks for backward compatibility
    && ln -s /lib/x86_64-linux-gnu/libtinfo.so.6 /lib/x86_64-linux-gnu/libtinfo.so.5 \
    && ln -s /lib/x86_64-linux-gnu/libncurses.so.6 /lib/x86_64-linux-gnu/libncurses.so.5 \
    && ln -s /lib/x86_64-linux-gnu/libncursesw.so.6 /lib/x86_64-linux-gnu/libncursesw.so.5 \
    # Generate locale
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    # Clean apt cache
    && rm -rf /var/lib/apt/lists/*

# Set locale environment variables
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Install Vivado in batch mode using mounted files with write permissions
RUN --mount=type=bind,source=vivado_installer,target=/tmp/vivado_installer,rw \
    --mount=type=bind,source=install_config.txt,target=/tmp/install_config.txt \
    cd /tmp/vivado_installer && \
    chmod +x xsetup && \
    ./xsetup --agree 3rdPartyEULA,XilinxEULA \
    --batch Install \
    --config /tmp/install_config.txt && \
    rm -rf /opt/Xilinx/.xinstall 2> /dev/null

# ---- Final stage ----
FROM ubuntu:24.04

# Copy Vivado installation from builder
COPY --from=builder /opt/Xilinx /opt/Xilinx

# Install runtime dependencies
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    # Core compatibility libraries
    libncurses6 \
    libtinfo6 \
    libstdc++6 \
    libc6-i386 \
    # Development tools
    make \
    libudev-dev \
    gcc \
    cmake \
    libusb-1.0-0-dev \
    libfreetype6 \
    libfontconfig1 \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    x11-utils \
    xvfb \
    xauth \
    libgtk-3-0 \
    libcanberra-gtk-module \
    libcanberra-gtk3-module \
    libdbus-glib-1-2 \
    libxt6 \
    libxmu6 \
    libxkbcommon-x11-0 \
    libyaml-dev \
    libyaml-0-2 \
    bison \
    flex \
    git \
    curl \
    xxd \
    gcc-arm-linux-gnueabihf \
    g++-arm-linux-gnueabihf \
    binutils-arm-linux-gnueabihf \
    libc6-dev-armhf-cross \
    wget \
    libssl-dev \
    openssl \
    libgnutls28-dev \
    gnutls-bin \
    bc \
    u-boot-tools \
    rsync \
    python3-sphinx \
    python3-venv \
    python3-yaml \
    imagemagick \
    graphviz \
    dvipng \
    latexmk \
    librsvg2-bin \
    texlive-lang-chinese \
    texlive-xetex \
    fonts-noto-cjk \
    # Locale support
    locales \
    # Symlinks for Vivado compatibility
    && ln -s /lib/x86_64-linux-gnu/libtinfo.so.6 /lib/x86_64-linux-gnu/libtinfo.so.5 \
    && ln -s /lib/x86_64-linux-gnu/libncurses.so.6 /lib/x86_64-linux-gnu/libncurses.so.5 \
    && ln -s /lib/x86_64-linux-gnu/libncursesw.so.6 /lib/x86_64-linux-gnu/libncursesw.so.5 \
    # Generate locale
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    # Clean apt cache
    && rm -rf /var/lib/apt/lists/*

# Set locale environment variables
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Set Vivado environment variables
ENV XILINX_VIVADO=/opt/Xilinx/2025.1/Vivado
ENV PATH="${XILINX_VIVADO}/bin:${PATH}"

# Default command
CMD ["/bin/bash"]